<Window x:Class="khokhlov_trpo_wpf4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:khokhlov_trpo_wpf4"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <local:Course x:Key="CurrentCourse"/>
    </Window.Resources>
    <Window.DataContext>
        <Binding Source="{StaticResource CurrentCourse}"/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <Label Content="ID"/>
            <Label Content="Название"/>
            <Label Content="Преподаватель"/>
            <Label Content="Стоимость часа"/>
            <Label Content="Количество часов"/>
            <Label Content="Полная стоимость"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True"/>
            <TextBox Margin="5" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Teacher, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding PricePerHour, UpdateSourceTrigger=LostFocus}"/>
            <TextBox Margin="5" Text="{Binding Hours, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Margin="5" Text="{Binding TotalCost, Mode=OneWay}" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="20,0,0,0">
            <TextBlock Text="Поиск по ID:"/>
            <TextBox x:Name="SearchBox" Margin="0,5,0,5"/>
            <Button Content="Найти" Width="120" Margin="0,0,0,20" Click="FindCourse"/>
            <Button Content="Сохранить" Width="120" Margin="0,0,0,10" Click="SaveCourse"/>
            <Button Content="Новая запись" Width="120" Click="NewCourse"/>
        </StackPanel>
    </Grid>
</Window>
